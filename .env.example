# ─── AI-Powered Client-Server System ─────────────────────────────────────────
# Copy this file to .env and fill in the values.

# ── Network ──────────────────────────────────────────────────────────────────
HOST=localhost
PORT=9000
MAX_CLIENTS=50

# ── Anthropic Claude AI ─────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_MODEL=claude-sonnet-4-20250514
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60

# ── TLS / SSL ────────────────────────────────────────────────────────────────
# Set to true to enable wss:// (auto-generates self-signed cert for dev)
TLS_ENABLED=false
TLS_CERT_FILE=cert.pem
TLS_KEY_FILE=key.pem
